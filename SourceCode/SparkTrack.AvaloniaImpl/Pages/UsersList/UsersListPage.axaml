<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             xmlns:converters="clr-namespace:SparkTrack.AvaloniaImpl.Converters"
             xmlns:dataGridColumns="clr-namespace:SparkTrack.AvaloniaImpl.DataGridColumns"
             xmlns:telegramTag="clr-namespace:SparkTrack.AvaloniaImpl.Controls.TelegramTag"
             xmlns:users="clr-namespace:SparkTrack.AvaloniaImpl.Pages.UsersList"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SparkTrack.AvaloniaImpl.Pages.UsersList.UsersListPage"
             x:DataType="users:UsersListPageViewModel"
             x:Name="Root">
    <UserControl.Resources>
        <converters:RoleConverter x:Key="RoleConverter" />
    </UserControl.Resources>
    <Grid RowDefinitions="Auto Auto Auto * Auto" RowSpacing="8">
        <TextBlock Classes="title" Grid.Row="0" DataContext="{x:Type users:UsersListPageViewModel}" x:DataType="system:Type"
                   Text="{Binding ., Converter={x:Static converters:PagesConverters.Name}}" />
        
        <Button Grid.Row="1" Classes="accent" HorizontalAlignment="Right" Content="Создать" 
                Command="{Binding OpenUserAddAsync}" />
        
        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Spacing="8" Orientation="Horizontal" >
            <Button Content="Удалить" HotKey="Delete" Command="{Binding DeleteCommand}" />
            <Button  Classes="icon reload f5-hot-key" Command="{Binding ReloadTableCommand}"/>
        </StackPanel>
        
        <DataGrid Grid.Row="3"
                  Classes="readonly"
                  Sorting="DataGrid_OnSorting"
                  LoadingRow="DataGrid_OnLoadingRow"
                  UnloadingRow="DataGrid_OnUnloadingRow"
                  ItemsSource="{Binding CurrentPageData}">
            <DataGrid.Columns>
                <dataGridColumns:DataGridSelectionColumn Binding="{Binding IsSelected, Mode=TwoWay}" />
                <DataGridTemplateColumn Width="*" IsReadOnly="True"
                                    Header="Имя">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Model.Name}"/>
                                <telegramTag:TelegramTag Text="{Binding Model.TelegramTag, StringFormat='@{0}'}"
                                                         IsVisible="{Binding Model.TelegramTag, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn IsReadOnly="True" Width="200"
                                    Header="Почта" Binding="{Binding Model.Email}" />
                <DataGridTextColumn Width="120" IsReadOnly="True"
                                    Header="Роль" Binding="{Binding Model.Role, Converter={StaticResource RoleConverter}}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
