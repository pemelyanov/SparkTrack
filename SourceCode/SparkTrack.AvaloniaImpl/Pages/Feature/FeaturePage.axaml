<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:markupExtensions="clr-namespace:FluentIcons.Avalonia.Fluent.MarkupExtensions;assembly=FluentIcons.Avalonia.Fluent"
             xmlns:feature="clr-namespace:SparkTrack.AvaloniaImpl.Pages.Feature"
             xmlns:subTask="clr-namespace:SparkTrack.AvaloniaImpl.Controls.SubTask"
             xmlns:comment="clr-namespace:SparkTrack.AvaloniaImpl.Controls.Comment"
             xmlns:converters="clr-namespace:SparkTrack.AvaloniaImpl.Converters"
             xmlns:behaviors="clr-namespace:SparkTrack.AvaloniaImpl.Behaviors"
             xmlns:attachment="clr-namespace:SparkTrack.AvaloniaImpl.Controls.Attachment"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SparkTrack.AvaloniaImpl.Pages.Feature.FeaturePage"
             x:DataType="feature:FeaturePageViewModel">
    <UserControl.Resources>
        <converters:ComparisonConverter x:Key="LessOrEqualConverter" Operation="Elt" />
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Panel#FilesPanel Rectangle#DashRectangle">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector=":is(Window):drag-over Panel#FilesPanel Rectangle#DashRectangle">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="UseFloatingWatermark" Value="True" />
        </Style>
        
        <Style Selector="TextBox.title">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="24" />
        </Style>
        
        <Style Selector=":is(Control).title-container">
            <Setter Property="Transitions">
                <Transitions>
                    <ThicknessTransition Property="Margin" Duration="0:0:0.25" />
                </Transitions>
            </Setter>
            
            <Style Selector="^.back-offset">
                <Setter Property="Margin" Value="32 0 0 0" />
            </Style>
        </Style>
    </UserControl.Styles>
    <Panel>
        <ScrollViewer x:Name="MainScrollViewer">
            <StackPanel Spacing="8">
                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <StackPanel Classes="title-container"
                                    Classes.back-offset="{Binding #MainScrollViewer.Offset.Y, Converter={StaticResource LessOrEqualConverter}, ConverterParameter=56}"
                            Spacing="8" Orientation="Horizontal" MaxWidth="500" HorizontalAlignment="Left">
                            <Panel>
                                <TextBlock IsVisible="{Binding !IsNameEditing}" Classes="title" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBox UseFloatingWatermark="False" IsVisible="{Binding IsNameEditing}" Classes="title" Text="{Binding Name}" />
                            </Panel>
                            
                            <ToggleButton Classes.edit="{Binding !IsNameEditing}"
                                          Classes.save="{Binding IsNameEditing}"
                                          IsChecked="{Binding IsNameEditing, Mode=TwoWay}" />
                        </StackPanel>
                        <TextBlock Text="Задачи: " />
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      PointerWheelChanged="InputElement_OnPointerWheelChanged">
                            <StackPanel Spacing="8" Orientation="Horizontal">
                                <ItemsControl ItemsSource="{Binding SubTasksList}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <subTask:SubTask />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="{markupExtensions:SymbolIcon Symbol=Add}"
                                        Command="{Binding AddSubTask}"
                                        ToolTip.Tip="Добавить задачу" />
                            </StackPanel>
                        </ScrollViewer>
                        <TextBox Watermark="Описание" AcceptsReturn="True" AcceptsTab="True" MinHeight="300"
                                 Text="{Binding Description}" />

                        <Panel HorizontalAlignment="Stretch">
                            <TextBlock Text="Файлы: " HorizontalAlignment="Left" />
                            <Button Content="Добавить" HorizontalAlignment="Right" />
                        </Panel>

                        <Panel x:Name="FilesPanel" Background="Transparent"
                               Loaded="FilesPanel_OnLoaded"
                               Unloaded="FilesPanel_OnUnloaded"
                               DragDrop.AllowDrop="True"
                               behaviors:DragDropBehaviors.AddDragOverClass="True"
                               MinHeight="50">
                            <ItemsControl ItemsSource="{Binding AttachmentsList}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel ItemSpacing="8" LineSpacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <attachment:AttachmentControl />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Rectangle x:Name="DashRectangle" IsHitTestVisible="False" StrokeDashArray="5, 1"
                                       Stroke="{DynamicResource ButtonForeground}"
                                       StrokeThickness="2" RadiusX="8" RadiusY="8" Opacity="0.8" />
                        </Panel>
                    </StackPanel>
                </Border>

                <Button Content="Комментарий" HorizontalAlignment="Right" Margin="0 0 8 0" />

                <ItemsControl ItemsSource="{Binding CommentsList}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <comment:Comment />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        
        <Button Classes="back" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top" Command="{Binding Back}" />
        
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="8">
            <Button Classes="reload" Command="{Binding RefreshCommand}"/>
            <Button Classes="accent" Content="Сохранить" Command="{Binding SaveCommand}" />
        </StackPanel>
    </Panel>
</UserControl>