<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:markupExtensions="clr-namespace:FluentIcons.Avalonia.Fluent.MarkupExtensions;assembly=FluentIcons.Avalonia.Fluent"
             xmlns:feature="clr-namespace:SparkTrack.AvaloniaImpl.Pages.Feature"
             xmlns:subTask="clr-namespace:SparkTrack.AvaloniaImpl.Controls.SubTask"
             xmlns:comment="clr-namespace:SparkTrack.AvaloniaImpl.Controls.Comment"
             xmlns:converters="clr-namespace:SparkTrack.AvaloniaImpl.Converters"
             xmlns:attachmentsPanel="clr-namespace:SparkTrack.AvaloniaImpl.Controls.AttachmentsPanel"
             xmlns:commentEdit="clr-namespace:SparkTrack.AvaloniaImpl.Controls.CommentEdit"
             xmlns:mdxaml="https://github.com/whistyun/Markdown.Avalonia.Tight"
             xmlns:localMarkupExtensions="clr-namespace:SparkTrack.AvaloniaImpl.MarkupExtensions"
             xmlns:editDates="clr-namespace:SparkTrack.AvaloniaImpl.Controls.EditDates"
             xmlns:link="clr-namespace:SparkTrack.AvaloniaImpl.Controls.Link"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SparkTrack.AvaloniaImpl.Pages.Feature.FeaturePage"
             x:DataType="feature:FeaturePageViewModel"
             x:Name="Root">
    <UserControl.Resources>
        <converters:ComparisonConverter x:Key="LessOrEqualConverter" Operation="Elt" />
        <converters:UriToImageSourceConverter x:Key="PathToImageSourceConverter" />
        <system:Double x:Key="PreviewSize">512</system:Double>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="TextBox.subtitle">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="20" />
        </Style>

        <Style Selector=":is(Control).title-container">
            <Setter Property="Transitions">
                <Transitions>
                    <ThicknessTransition Property="Margin" Duration="0:0:0.25" />
                </Transitions>
            </Setter>

            <Style Selector="^.back-offset">
                <Setter Property="Margin" Value="32 0 0 0" />
            </Style>
        </Style>

        <Style Selector="ContentControl.description-edit">
            <Setter Property="Content">
                <Template>
                    <TextBox x:Name="MarkdownEdit" AcceptsReturn="True" AcceptsTab="True" UseFloatingWatermark="False"
                             TextWrapping="Wrap"
                             MinHeight="200" PastingFromClipboard="TextBox_OnPastingFromClipboard" />
                </Template>
            </Setter>
        </Style>

        <Style Selector="ContentControl.description-view">
            <Style Selector="^ Border.card">
                <Setter Property="Padding" Value="8" />
            </Style>
            <Setter Property="Content">
                <Template>
                    <mdxaml:MarkdownScrollViewer x:Name="Markdown" Markdown="{Binding $self.Tag, Mode=TwoWay}" />
                </Template>
            </Setter>
        </Style>

        <Style Selector="ContentControl.reel-description">
            <Style Selector="^ TextBox#MarkdownEdit">
                <Setter Property="Text" Value="{Binding ReelDescription, Mode=TwoWay}" />
            </Style>

            <Style Selector="^ mdxaml|MarkdownScrollViewer#Markdown">
                <Setter Property="Tag" Value="{Binding ReelDescription}" />
            </Style>
        </Style>

        <Style Selector="ContentControl.preview-description">
            <Style Selector="^ TextBox#MarkdownEdit">
                <Setter Property="Text" Value="{Binding PreviewDescription, Mode=TwoWay}" />
            </Style>

            <Style Selector="^ mdxaml|MarkdownScrollViewer#Markdown">
                <Setter Property="Tag" Value="{Binding PreviewDescription}" />
            </Style>
        </Style>

        <Style Selector="ContentControl.attachment-preview">
            <Setter Property="Content">
                <Template>
                    <Image
                        Source="{Binding PreviewAttachment.Uri, Converter={StaticResource PathToImageSourceConverter}}" />
                </Template>
            </Setter>
        </Style>
    </UserControl.Styles>
    <Panel>
        <ScrollViewer x:Name="MainScrollViewer">
            <StackPanel Spacing="8">
                <Border Classes="card" Padding="16 8 16 16">
                    <StackPanel Spacing="8">
                        <StackPanel Classes="title-container"
                                    Classes.back-offset="{Binding #MainScrollViewer.Offset.Y, Converter={StaticResource LessOrEqualConverter}, ConverterParameter=32}"
                                    Spacing="8" Orientation="Horizontal" HorizontalAlignment="Left">
                            <Panel>
                                <SelectableTextBlock Margin="0 2 0 0" IsVisible="{Binding !IsNameEditing}"
                                                     Classes="subtitle"
                                                     Text="{Binding Name}"
                                                     TextTrimming="CharacterEllipsis" MaxWidth="500" />
                                <TextBox Padding="6 2" UseFloatingWatermark="False" Width="500"
                                         IsVisible="{Binding IsNameEditing}"
                                         Classes="subtitle" Text="{Binding Name}" />
                            </Panel>

                            <ToggleButton Classes="icon"
                                          IsVisible="{localMarkupExtensions:CurrentUserInRole Admin}"
                                          Classes.edit="{Binding !IsNameEditing}"
                                          Classes.save="{Binding IsNameEditing}"
                                          IsChecked="{Binding IsNameEditing, Mode=TwoWay}" />
                        </StackPanel>
                        
                        <Separator />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Канал:" />
                            <link:Link Text="{Binding Project.Name}" Url="{Binding Project.Link}" />
                        </StackPanel>
                        
                        <Separator />

                        <TextBlock Text="Задачи: " />
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      PointerWheelChanged="InputElement_OnPointerWheelChanged">
                            <StackPanel Spacing="8" Orientation="Horizontal">
                                <ItemsControl ItemsSource="{Binding SubTasksList}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <subTask:SubTask
                                                IsForEmployee="{localMarkupExtensions:CurrentUserInRole Employee}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Spacing="4" IsVisible="{localMarkupExtensions:CurrentUserInRole Admin}"
                                            Orientation="Horizontal">
                                    <Button Classes="icon medium-content"
                                            Content="{markupExtensions:SymbolIcon Symbol=Add}"
                                            Command="{Binding AddSubTask}"
                                            CornerRadius="4 0 0 4"
                                            ToolTip.Tip="Добавить задачу" />

                                    <Button Classes="icon template" CornerRadius="0 4 4 0"
                                            Command="{Binding AddSubTaskFromTemplateAsync}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <Separator />

                        <!-- TODO: В будущем подумать как переделать это в механизм. -->
                        <!-- Заказчику нужно делить описание на 3 поля и большое превью, -->
                        <!-- но я не хочу жертвовать гибкостью системы, поэтому будем хранить описание Json строкой вот такой структуры, -->
                        <!-- возможно потом можно будет сделать механизм подключения разных шаблонов для описания -->
                        <Grid ColumnDefinitions="* Auto" RowDefinitions="Auto * *" RowSpacing="8" ColumnSpacing="8">
                            <Grid Grid.Column="0" Grid.Row="0" ColumnDefinitions="* Auto" ColumnSpacing="8">
                                <link:Link Grid.Column="0" Url="{Binding ReelLink}"
                                           IsVisible="{Binding !IsEditingLink}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="0" Text="{Binding ReelLink}" IsVisible="{Binding IsEditingLink}"
                                         PastingFromClipboard="TextBox_OnPastingFromClipboard" />
                                <ToggleButton Grid.Column="1" Classes="icon"
                                              Classes.edit="{Binding !IsEditingLink}"
                                              Classes.save="{Binding IsEditingLink}"
                                              IsChecked="{Binding IsEditingLink, Mode=TwoWay}"
                                              IsVisible="{localMarkupExtensions:CurrentUserInRole Admin}" />
                            </Grid>

                            <Border Classes="card" Grid.Row="1" Grid.Column="0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Ролик:" VerticalAlignment="Center" />
                                        <ToggleSwitch Classes="markdown-view-switch"
                                                      IsVisible="{localMarkupExtensions:CurrentUserInRole Admin}"
                                                      IsChecked="{Binding IsReelDescriptionInPreviewMode, Mode=TwoWay}" />
                                    </StackPanel>

                                    <Separator />

                                    <ContentControl Classes="reel-description"
                                                    Classes.description-edit="{Binding !IsReelDescriptionInPreviewMode}"
                                                    Classes.description-view="{Binding IsReelDescriptionInPreviewMode}"
                                                    Tag="{Binding ReelDescription, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>

                            <Border Classes="card" Grid.Row="2" Grid.Column="0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Превью:" VerticalAlignment="Center" />
                                        <ToggleSwitch Classes="markdown-view-switch"
                                                      IsVisible="{localMarkupExtensions:CurrentUserInRole Admin}"
                                                      IsChecked="{Binding IsPreviewDescriptionInPreviewMode, Mode=TwoWay}" />
                                    </StackPanel>

                                    <Separator />

                                    <ContentControl Classes="preview-description"
                                                    Classes.description-edit="{Binding !IsPreviewDescriptionInPreviewMode}"
                                                    Classes.description-view="{Binding IsPreviewDescriptionInPreviewMode}"
                                                    Tag="{Binding PreviewDescription, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>

                            <Border Classes="card" Grid.Row="1" Grid.Column="1" Grid.RowSpan="2"
                                    Width="{StaticResource PreviewSize}"
                                    Height="{StaticResource PreviewSize}" VerticalAlignment="Top">
                                <ContentControl
                                    Classes.attachment-preview="{Binding AttachmentsPanelViewModel.AttachmentsList.Count}" />
                            </Border>
                        </Grid>

                        <Separator />

                        <attachmentsPanel:AttachmentsPanel
                            Classes="previewable"
                            IsReadOnly="{localMarkupExtensions:CurrentUserInRole Employee}"
                            DataContext="{Binding AttachmentsPanelViewModel}" />

                        <editDates:EditDates CreatedAt="{Binding CreatedAt}" EditedAt="{Binding EditedAt}" />
                    </StackPanel>
                </Border>

                <Panel IsVisible="{Binding CanAddComments}">
                    <TextBlock Text="Комментарии: " VerticalAlignment="Center" />

                    <Button Content="Новый комментарий" HorizontalAlignment="Right" Margin="0 0 8 0"
                            Command="{Binding CreateComment}" />
                </Panel>

                <ItemsControl ItemsSource="{Binding CommentsList}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <comment:Comment />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border x:Name="CommentCreationControl" Classes="card"
                        IsVisible="{Binding CommentEditViewModel, Converter={x:Static ObjectConverters.IsNotNull}}"
                        IsEnabled="{Binding $self.IsVisible}">
                    <StackPanel Spacing="8">
                        <commentEdit:CommentEdit DataContext="{Binding CommentEditViewModel}" />

                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Classes="accent" Content="Создать" Command="{Binding SaveCommentCommand}"
                                    HotKey="Enter" />
                            <Button Content="Отмена" Command="{Binding CancelComment}" HotKey="Escape" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Button Classes="icon back" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top"
                Command="{Binding Back}"
                Classes.esc-hot-key="{Binding !IsEditingComment}" />

        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="8">
            <Button Classes="icon reload f5-hot-key" Command="{Binding RefreshCommand}" />

            <Button Classes="icon template-add" Command="{Binding CreateTemplateAsync}"
                    IsVisible="{localMarkupExtensions:CurrentUserInRole Admin}" />

            <Button Classes="accent" Content="Сохранить"
                    Classes.enter-hot-key="{Binding CanSaveByHotKey}"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding $self.IsVisible}"
                    IsVisible="{localMarkupExtensions:CurrentUserInRole Admin}" />
        </StackPanel>
    </Panel>
</UserControl>