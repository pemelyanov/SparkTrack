<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SparkTrack.AvaloniaImpl.Controls.RangeDatePicker.RangeDatePicker"
             x:Name="Root">
    <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{Binding #Root.Label}" IsVisible="{Binding #Root.Label, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" VerticalAlignment="Center" />
        <CalendarDatePicker SelectedDate="{Binding #Root.StartDate}" DisplayDateEnd="{Binding #Root.EndDate}" Width="180" Watermark="ДД.ММ.ГГГГ"/>
        <TextBlock VerticalAlignment="Center" Text="—" />
        <CalendarDatePicker SelectedDate="{Binding #Root.EndDate}" DisplayDateStart="{Binding #Root.StartDate}" Width="180" Watermark="ДД.ММ.ГГГГ" />
    </StackPanel>
</UserControl>
