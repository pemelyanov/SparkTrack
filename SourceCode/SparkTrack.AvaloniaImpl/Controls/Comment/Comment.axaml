<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:comment="clr-namespace:SparkTrack.AvaloniaImpl.Controls.Comment"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SparkTrack.AvaloniaImpl.Controls.Comment.Comment"
             x:DataType="comment:CommentViewModel">
    <Border Classes="card">
        <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="subtitle" Text="{Binding Model.Author.Name}" />
                <SelectableTextBlock Classes="subtitle" Opacity="0.7" Text="{Binding Model.Author.Email, StringFormat='({0})'}" />
            </StackPanel>
            
            <TextBlock Text="{Binding Model.Text}" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</UserControl>
