<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:avalonia="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
             xmlns:markupExtensions="clr-namespace:FluentIcons.Avalonia.MarkupExtensions;assembly=FluentIcons.Avalonia"
             xmlns:attachment="clr-namespace:SparkTrack.AvaloniaImpl.Controls.Attachment"
             xmlns:converters="clr-namespace:SparkTrack.AvaloniaImpl.Converters"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SparkTrack.AvaloniaImpl.Controls.Attachment.AttachmentControl"
             x:DataType="attachment:IAttachmentViewModel"
             x:Name="Root">
    <UserControl.Resources>
        <converters:PathToImageSourceConverter x:Key="PathToImageSourceConverter" />
        <converters:BytesToStringConverter x:Key="BytesToStringConverter" />
        <converters:FileExtensionToSymbolConverter x:Key="FileExtensionToSymbolConverter" />
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="ContentControl.image">
            <Setter Property="Content">
                <Template>
                    <Image x:DataType="attachment:IAttachmentViewModel"
                           Source="{Binding Uri, Converter={StaticResource PathToImageSourceConverter}}" />
                </Template>
            </Setter>
        </Style>

        <Style Selector="ContentControl.file">
            <Setter Property="Content">
                <Template>
                    <Border x:DataType="attachment:IAttachmentViewModel" IsVisible="{Binding LoadProgress, Converter={x:Static ObjectConverters.IsNull}}">
                        <avalonia:SymbolIcon
                            Symbol="{Binding Extension, Converter={StaticResource FileExtensionToSymbolConverter}}" />
                    </Border>
                </Template>
            </Setter>
        </Style>

        <Style Selector=":is(Control).half-transparent">
            <Setter Property="Opacity" Value="0.35" />
        </Style>

        <Style Selector=":is(Panel).file-actions Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>
    <Border Classes="card" x:Name="Container" Padding="0">
        <Grid ColumnDefinitions="Auto * Auto" Width="256">
            <ContentControl Classes.half-transparent="{Binding #Container.IsPointerOver}"
                            Classes.file="{Binding !IsImage}"
                            Classes.image="{Binding IsImage}"
                            Grid.Column="0" Width="64" Height="64" />

            <Panel Grid.Column="0" Classes="file-actions">
                <Panel.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="#Container.IsPointerOver" />
                        <Binding Path="LoadProgress" Converter="{x:Static ObjectConverters.IsNull}" />
                    </MultiBinding>
                </Panel.IsVisible>
                <Button Content="{markupExtensions:SymbolIcon Symbol=ArrowDownload}"
                        Command="{Binding DownloadAsync}"
                        IsVisible="{Binding !IsDownloaded}" />

                <Button Content="{markupExtensions:SymbolIcon Symbol=Open}" Command="{Binding Open}"
                        IsVisible="{Binding IsDownloaded}" />
            </Panel>

            <Panel Grid.Column="0" IsVisible="{Binding LoadProgress, Converter={x:Static ObjectConverters.IsNotNull}}">
                <avalonia:SymbolIcon
                    Symbol="{Binding LoadProgress.LoadType, Mode=OneWay, Converter={x:Static attachment:AttachmentControl.LoadingIconConverter}}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />

                <controls:ProgressRing Maximum="{Binding LoadProgress.Progress.TotalProgress^}"
                                       Value="{Binding LoadProgress.Progress.CurrentProgress^}"
                                       IsIndeterminate="False"
                                       Width="NaN"
                                       Height="NaN"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch" />
            </Panel>

            <TextBlock Grid.Column="1" Text="{Binding Name}"
                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" />

            <TextBlock Grid.Column="1" Text="{Binding Size, Converter={StaticResource BytesToStringConverter}}"
                       HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"
                       FontSize="12" Opacity="0.75" />

            <StackPanel Grid.Column="2" Margin="4" IsVisible="{Binding #Container.IsPointerOver}" Spacing="4">
                <Button Classes="icon small close"
                        IsVisible="{Binding !#Root.IsReadOnly}"
                        Command="{Binding Remove}" />

                <Button Classes="icon small more">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Сохранить как..." Command="{Binding SaveAsCommand}" />
                            <MenuItem Header="Открыть в проводнике" Command="{Binding OpenInExplorer}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>