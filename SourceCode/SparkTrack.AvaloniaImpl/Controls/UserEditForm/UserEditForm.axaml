<controls:ContentDialog xmlns="https://github.com/avaloniaui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                        xmlns:userEditForm="clr-namespace:SparkTrack.AvaloniaImpl.Controls.UserEditForm"
                        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                        x:Class="SparkTrack.AvaloniaImpl.Controls.UserEditForm.UserEditForm"
                        x:DataType="userEditForm:UserEditFormViewModel"
                        Title="Редактирование пользователя"
                        DefaultButton="Primary"
                        PrimaryButtonText="Сохранить"
                        PrimaryButtonCommand="{Binding SaveUserCommand}"
                        SecondaryButtonText="Сбросить пароль"
                        SecondaryButtonCommand="{Binding ResetPasswordCommand}"
                        CloseButtonText="Закрыть">
    <StackPanel Width="400" Spacing="8">
        <TextBox Watermark="Имя" Text="{Binding Name}" />
        <TextBox Watermark="Email" Text="{Binding Email}" />
        <TextBox Watermark="Telegram Tag (необязательно)" Text="{Binding TelegramTag}" />

        <StackPanel IsVisible="{Binding GeneratedPassword, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Spacing="8">
            <TextBlock Text="Пароль сброшен. Для входа используйте указанную почту и пароль ниже:"
                       TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <SelectableTextBlock Text="{Binding GeneratedPassword}" VerticalAlignment="Center" />
                <Button Classes="icon copy" VerticalAlignment="Center"
                        Command="{Binding CopyGeneratedPasswordAsync}" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</controls:ContentDialog>