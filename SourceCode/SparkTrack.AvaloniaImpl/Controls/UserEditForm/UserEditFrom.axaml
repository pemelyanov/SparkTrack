<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:userEditForm="clr-namespace:SparkTrack.AvaloniaImpl.Controls.UserEditForm"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SparkTrack.AvaloniaImpl.Controls.UserEditForm.UserEditFrom"
             x:DataType="userEditForm:UserEditFormViewModel">
    <StackPanel>
        <TextBox Watermark="Имя" Text="{Binding Name}"
                 IsReadOnly="{Binding GeneratedPassword, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBox Watermark="Email" Text="{Binding Email}"
                 IsReadOnly="{Binding GeneratedPassword, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <StackPanel>
            <TextBlock Text="Пользователь успешно создан. Для входа используйте указанную почту и пароль ниже:"
                       TextAlignment="Center" HorizontalAlignment="Center" />
            <SelectableTextBlock Text="{Binding GeneratedPassword}" HorizontalAlignment="Center" />
        </StackPanel>


        <Button Content="Создать" Command="{Binding CreateUserCommand}" />
    </StackPanel>
</UserControl>