<controls:ContentDialog xmlns="https://github.com/avaloniaui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                        xmlns:behaviors="clr-namespace:SparkTrack.AvaloniaImpl.Behaviors"
                        xmlns:changePasswordForm="clr-namespace:SparkTrack.AvaloniaImpl.Controls.ChangePasswordForm"
                        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                        x:Class="SparkTrack.AvaloniaImpl.Controls.ChangePasswordForm.ChangePasswordForm"
                        x:DataType="changePasswordForm:ChangePasswordFormViewModel"
                        Title="Смена пароля"
                        DefaultButton="Primary"
                        PrimaryButtonText="Сменить"
                        PrimaryButtonCommand="{Binding ChangePasswordCommand}"
                        CloseButtonText="Отмена"
                        CloseButtonCommand="{Binding CloseCommand}">
    <StackPanel Width="400" Spacing="8">
        <TextBox Classes="password" Watermark="Текущий пароль" Text="{Binding CurrentPassword}"
                 behaviors:FocusBehaviors.FocusOnLoaded="True" />
        <TextBox Classes="password" Watermark="Новый пароль" Text="{Binding NewPassword}" />
        <TextBox Classes="password" Watermark="Подтверждение пароля" Text="{Binding NewPasswordConfirmation}" />
    </StackPanel>
</controls:ContentDialog>