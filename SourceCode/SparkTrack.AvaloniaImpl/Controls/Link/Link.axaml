<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SparkTrack.AvaloniaImpl.Controls.Link.Link"
             x:Name="Root">
    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentButtonBackground}" />
        
            <Style Selector="^:pointerover">
                <Setter Property="Foreground" Value="{DynamicResource AccentButtonBackgroundPointerOver}" />
                <Setter Property="TextDecorations" Value="Underline" />
            </Style>
        </Style>
    </UserControl.Styles>
    <TextBlock Text="{Binding #Root.DisplayText}" Tapped="InputElement_OnTapped" PointerPressed="InputElement_OnPointerPressed" />
</UserControl>
