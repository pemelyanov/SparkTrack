<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:commentEdit="clr-namespace:SparkTrack.AvaloniaImpl.Controls.CommentEdit"
             xmlns:attachmentsPanel="clr-namespace:SparkTrack.AvaloniaImpl.Controls.AttachmentsPanel"
             xmlns:mdxaml="https://github.com/whistyun/Markdown.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SparkTrack.AvaloniaImpl.Controls.CommentEdit.CommentEdit"
             x:DataType="commentEdit:CommentEditViewModel">
    <UserControl.Styles>
        <Style Selector="ContentControl.description-edit">
            <Setter Property="Content">
                <Template>
                    <TextBox AcceptsReturn="True" AcceptsTab="True" UseFloatingWatermark="False"
                             Text="{Binding Text}" TextWrapping="Wrap"
                             MinHeight="200" PastingFromClipboard="TextBox_OnPastingFromClipboard" />
                </Template>
            </Setter>
        </Style>

        <Style Selector="ContentControl.description-view">
            <Style Selector="^ Border.card">
                <Setter Property="Padding" Value="8" />
            </Style>
            
            <Setter Property="Content">
                <Template>
                    <Border Classes="card">
                        <mdxaml:MarkdownScrollViewer x:Name="Markdown" Markdown="{Binding Text}" />
                    </Border>
                </Template>
            </Setter>
        </Style>
    </UserControl.Styles>
    <StackPanel Spacing="8">
        <TextBlock Text="Комментарий" Classes="subtitle" />
        
        <ToggleSwitch Classes="markdown-view-switch"
                      IsChecked="{Binding IsInPreviewMode, Mode=TwoWay}" />

        <ContentControl Classes.description-edit="{Binding !IsInPreviewMode}"
                        Classes.description-view="{Binding IsInPreviewMode}" />

        
        <attachmentsPanel:AttachmentsPanel DataContext="{Binding AttachmentsPanelViewModel}" />
    </StackPanel>
</UserControl>
