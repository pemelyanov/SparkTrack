<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:disablingWrapper="clr-namespace:SparkTrack.AvaloniaImpl.Controls.DisablingWrapper"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SparkTrack.AvaloniaImpl.Controls.DisablingWrapper.DisablingWrapper">
    <UserControl.Template>
        <ControlTemplate TargetType="disablingWrapper:DisablingWrapper">
            <Grid ColumnDefinitions="Auto *">
                <CheckBox Grid.Column="0" VerticalAlignment="Center" IsChecked="{TemplateBinding IsContentEnabled, Mode=TwoWay}"/>
                
                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" 
                                  IsEnabled="{TemplateBinding IsContentEnabled}"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Padding="{TemplateBinding Padding}"
                                  FontFamily="{TemplateBinding FontFamily}"
                                  FontSize="{TemplateBinding FontSize}"
                                  FontStyle="{TemplateBinding FontStyle}"
                                  FontWeight="{TemplateBinding FontWeight}"
                                  FontStretch="{TemplateBinding FontStretch}" />
            </Grid>
        </ControlTemplate>
    </UserControl.Template>
</UserControl>
