<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:subTask="clr-namespace:SparkTrack.AvaloniaImpl.Controls.SubTask"
             xmlns:markupExtensions="clr-namespace:FluentIcons.Avalonia.Fluent.MarkupExtensions;assembly=FluentIcons.Avalonia.Fluent"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SparkTrack.AvaloniaImpl.Controls.SubTask.SubTask"
             x:DataType="subTask:SubTaskViewModel">
    <UserControl.Styles>
        <Style Selector="TextBox">
            <Setter Property="UseFloatingWatermark" Value="True" />
        </Style>
        <Style Selector="CalendarDatePicker">
            <Setter Property="UseFloatingWatermark" Value="True" />
        </Style>
    </UserControl.Styles>
    <Border Classes="card">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Panel>
                <StackPanel IsVisible="{Binding IsInEditMode}" Spacing="8">
                    <TextBox Watermark="Задача" Text="{Binding Name}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Исполнитель: " />
                        <ComboBox ItemsSource="{Binding AvailableEmployees}" SelectedItem="{Binding SelectedEmployee}"
                                  DisplayMemberBinding="{Binding Name}" />
                    </StackPanel>
                    <CalendarDatePicker Watermark="Дедлайн" SelectedDate="{Binding Deadline}" />
                    <TextBox Watermark="Стоимость (₽)" Text="{Binding Cost}" />
                </StackPanel>

                <StackPanel IsVisible="{Binding !IsInEditMode}" Spacing="8">
                    <TextBlock Classes="caption" Text="{Binding Name}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Исполнитель: " />
                        <TextBlock Text="{Binding SelectedEmployee.Name}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Дедлайн: " />
                        <TextBlock Text="{Binding Deadline, StringFormat='dd.MM.yyyy'}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Стоимость: " />
                        <TextBlock Text="{Binding Cost, StringFormat='{}{0:C}'}" />
                    </StackPanel>
                </StackPanel>
            </Panel>

            <ToggleButton Classes.edit="{Binding !IsInEditMode}"
                          Classes.save="{Binding IsInEditMode}"
                          VerticalAlignment="Top"
                          IsChecked="{Binding IsInEditMode, Mode=TwoWay}" />
            
            <Button Content="{markupExtensions:SymbolIcon Symbol=Delete}" VerticalAlignment="Top"
                    Command="{Binding Delete}"/>
        </StackPanel>
    </Border>
</UserControl>