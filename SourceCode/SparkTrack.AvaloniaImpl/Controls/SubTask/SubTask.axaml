<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:subTask="clr-namespace:SparkTrack.AvaloniaImpl.Controls.SubTask"
             xmlns:converters="clr-namespace:SparkTrack.AvaloniaImpl.Converters"
             xmlns:behaviors="clr-namespace:SparkTrack.AvaloniaImpl.Behaviors"
             xmlns:markupExtensions="clr-namespace:SparkTrack.AvaloniaImpl.MarkupExtensions"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SparkTrack.AvaloniaImpl.Controls.SubTask.SubTask"
             x:DataType="subTask:SubTaskViewModel"
             x:Name="Root">
    <UserControl.Styles>
        <Style Selector="ContentControl.edit-control">
            <Setter Property="Content">
                <Template>
                    <StackPanel IsVisible="{Binding IsInEditMode}" Spacing="8">
                        <TextBox Watermark="Задача" Text="{Binding Name}" />
                        <Grid ColumnDefinitions="Auto *">
                            <TextBlock Text="Исполнитель: " VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding AvailableEmployees}"
                                      SelectedItem="{Binding SelectedEmployee}"
                                      DisplayMemberBinding="{Binding Name}"
                                      Grid.Column="1" HorizontalAlignment="Stretch" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto *">
                            <TextBlock Text="Дедлайн: " VerticalAlignment="Center" />
                            <CalendarDatePicker SelectedDate="{Binding Deadline}"
                                                Grid.Column="1" HorizontalAlignment="Stretch" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto *">
                            <TextBlock Text="Стоимость (₽): " VerticalAlignment="Center" />
                            <TextBox
                                Text="{Binding Cost, Converter={x:Static converters:StringToFloatConverter.Instance}}"
                                Grid.Column="1" HorizontalAlignment="Stretch">
                                <Interaction.Behaviors>
                                    <behaviors:FloatBoxBehavior />
                                </Interaction.Behaviors>
                            </TextBox>
                        </Grid>
                    </StackPanel>
                </Template>
            </Setter>
        </Style>

        <Style Selector="ContentControl.view-control">
            <Setter Property="Content">
                <Template>
                    <StackPanel IsVisible="{Binding !IsInEditMode}" Spacing="8">
                        <TextBlock Classes="caption" Text="{Binding Name}" />
                        <StackPanel Orientation="Horizontal" IsVisible="{Binding !#Root.IsForEmployee}">
                            <TextBlock Text="Исполнитель: " />
                            <TextBlock Text="{Binding SelectedEmployee.Name}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Дедлайн: " />
                            <TextBlock Text="{Binding Deadline, StringFormat='dd.MM.yyyy'}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Стоимость: " />
                            <TextBlock Text="{Binding Cost, StringFormat='{}{0:C}'}" />
                        </StackPanel>
                    </StackPanel>
                </Template>
            </Setter>
        </Style>
    </UserControl.Styles>
    <Border Classes="card">
        <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">

                <ContentControl Width="300" Classes.edit-control="{Binding IsInEditMode}"
                                Classes.view-control="{Binding !IsInEditMode}" />
            
                <StackPanel Spacing="8" Orientation="Horizontal" IsVisible="{Binding !#Root.IsForEmployee}"
                            HorizontalAlignment="Right">
                    <ToggleButton Classes="icon"
                                  Classes.edit="{Binding !IsInEditMode}"
                                  Classes.save="{Binding IsInEditMode}"
                                  VerticalAlignment="Top"
                                  IsChecked="{Binding IsInEditMode, Mode=TwoWay}" />

                    <Button Classes="icon delete" VerticalAlignment="Top"
                            Command="{Binding Delete}" />
                </StackPanel>
            </StackPanel>
            
            <Separator />
            
            <WrapPanel ItemSpacing="16" LineSpacing="8">
                <CheckBox Content="Выполнено" HorizontalAlignment="Right" />

                <CheckBox Content="На оплате" HorizontalAlignment="Right"
                          IsEnabled="{markupExtensions:CurrentUserInRole Admin}" />
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>