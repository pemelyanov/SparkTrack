<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="c:\temp\internal-nlog.txt">

	<!-- === ЛЕГКАЯ НАСТРОЙКА УРОВНЯ ЛОГИРОВАНИЯ === -->
	<!-- Доступные значения: Trace, Debug, Info, Warn, Error, Fatal, Off -->
	<variable name="minLogLevel" value="Info" />
	<variable name="avaloniaMinLogLevel" value="Error" />
	<!-- ============================================= -->

	<!-- === ОБЩИЙ ФОРМАТ ЛОГОВ (используется во всех targets) === -->
	<variable name="logLayout" 
			  value="${longdate} ${uppercase:${level}} [thread:${threadid}] |${logger}| ${message} ${exception:format=toString,Data}" />
	<!-- ========================================================= -->

	<!-- Целевые устройства вывода (targets) -->
	<targets>
		
		<!-- Цветная консоль с раскраской только уровня -->
		<target name="colorconsole" 
		        xsi:type="ColoredConsole" 
		        layout="${logLayout}"
		        wrapped="true"> <!-- Важно: wrapped="true" позволяет красить части строки -->
			
			<!-- Раскрашиваем только уровень логирования (часть строки) -->
			<highlight-word condition="level == LogLevel.Trace" foregroundColor="DarkGray" words="TRACE" />
			<highlight-word condition="level == LogLevel.Debug" foregroundColor="Gray" words="DEBUG" />
			<highlight-word condition="level == LogLevel.Info" foregroundColor="Green" words="INFO" />
			<highlight-word condition="level == LogLevel.Warn" foregroundColor="Yellow" words="WARN" />
			<highlight-word condition="level == LogLevel.Error" foregroundColor="Red" words="ERROR" />
			<highlight-word condition="level == LogLevel.Fatal" foregroundColor="Red" backgroundColor="White" words="FATAL" />
		</target>

		<!-- Файл с логами (с авто-архивацией) -->
		<target name="logfile" 
				xsi:type="File" 
				fileName="${specialfolder:folder=ApplicationData}/SparkTrack/logs/log-${shortdate}.log"
				layout="${logLayout}"
				archiveFileName="${specialfolder:folder=ApplicationData}/SparkTrack/logs/archives/log-${shortdate}-{##}.log"
				archiveEvery="Day"
				maxArchiveFiles="7"
				keepFileOpen="false"
				encoding="utf-8" />
	</targets>

	<!-- Правила маршрутизации логов -->
	<rules>
		<!-- Подключаем все целевые устройства с минимальным уровнем из переменной -->
		<logger name="*" minlevel="${minLogLevel}" writeTo="colorconsole,logfile" />
	</rules>
</nlog>