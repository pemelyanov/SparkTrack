<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SparkTrack.AvaloniaImpl.Windows.Main"
        xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
        xmlns:fluent="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
        xmlns:reactiveUi="http://reactiveui.net"
        xmlns:converters="clr-namespace:SparkTrack.AvaloniaImpl.Converters"
        xmlns:system="clr-namespace:System;assembly=System.Runtime"
        xmlns:account="clr-namespace:SparkTrack.AvaloniaImpl.Controls.Account"
        xmlns:markupExtensions="clr-namespace:FluentIcons.Avalonia.MarkupExtensions;assembly=FluentIcons.Avalonia"
        xmlns:behaviors="clr-namespace:SparkTrack.AvaloniaImpl.Behaviors"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="SparkTrack.AvaloniaImpl.Windows.Main.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/icon.ico"
        WindowStartupLocation="CenterScreen"
        Title="SparkTrack"
        DragDrop.AllowDrop="True"
        behaviors:DragDropBehaviors.AddDragOverClass="True"
        x:Name="Root">
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="WindowNotificationManager">
            <Setter Property="Width" Value="{Binding $parent[OverlayLayer].Bounds.Width}" />
            <Setter Property="Height" Value="{Binding $parent[OverlayLayer].Bounds.Height}" />

            <!-- NOTE: Почему-то из коробки оно не работает -->
            <Style Selector="^:bottomcenter /template/ ReversibleStackPanel#PART_Items">
                <Setter Property="ReverseOrder" Value="True" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
        </Style>

        <Style Selector="controls|NavigationView /template/ Grid#PaneContentGrid:not(:something)">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </Window.Styles>

    <Panel>
        <Border x:Name="SizeBox" SizeChanged="OnSizeChanged" />
        <Viewbox>
            <controls:NavigationView x:Name="NavigationView" IsPaneOpen="False" IsSettingsVisible="False"
                                     Width="{Binding #Root.ContentWidth}"
                                     Height="{Binding #Root.ContentHeight}"
                                     Background="Transparent"
                                     MenuItemsSource="{Binding NavigationList^}"
                                     SelectedItem="{Binding SelectedPageType, Mode=TwoWay}">
                <controls:NavigationView.MenuItemTemplate>
                    <DataTemplate x:DataType="system:Type">
                        <controls:NavigationViewItem SelectsOnInvoked="True"
                                                     Content="{Binding ., Converter={x:Static converters:PagesConverters.Name}}"
                                                     Tapped="NavigationItem_OnTapped" Tag="{Binding}">
                            <controls:NavigationViewItem.IconSource>
                                <fluent:SymbolIconSource
                                    Symbol="{Binding ., Converter={x:Static converters:PagesConverters.Symbol}}" />
                            </controls:NavigationViewItem.IconSource>
                        </controls:NavigationViewItem>
                    </DataTemplate>
                </controls:NavigationView.MenuItemTemplate>

                <controls:NavigationView.PaneFooter>
                    <StackPanel Spacing="4">
                        <Panel>
                            <ToggleButton Width="32" Height="32" Margin="10 0 0 0" Padding="4"
                                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                          Content="{markupExtensions:SymbolIcon Symbol=Person}"
                                          IsChecked="{Binding #NavigationView.IsPaneOpen, Mode=TwoWay}">
                                <ToggleButton.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="AccountViewModel.CurrentUser.Value"
                                                 Converter="{x:Static ObjectConverters.IsNotNull}" />
                                        <Binding Path="!#NavigationView.IsPaneOpen" />
                                    </MultiBinding>
                                </ToggleButton.IsVisible>
                            </ToggleButton>
                            <account:Account DataContext="{Binding AccountViewModel}"
                                             Margin="8 0">
                                <account:Account.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="CurrentUser.Value"
                                                 Converter="{x:Static ObjectConverters.IsNotNull}" />
                                        <Binding Path="#NavigationView.IsPaneOpen" />
                                    </MultiBinding>
                                </account:Account.IsVisible>
                            </account:Account>
                        </Panel>

                        <TextBlock Text="{Binding Copyright}" HorizontalAlignment="Center"
                                   IsVisible="{Binding #NavigationView.IsPaneOpen}" Opacity="0.7" />
                    </StackPanel>
                </controls:NavigationView.PaneFooter>

                <Grid RowDefinitions="Auto *" Margin="8" RowSpacing="8">
                    <reactiveUi:RoutedViewHost Grid.Row="1" Router="{Binding Router}" />
                </Grid>
            </controls:NavigationView>
        </Viewbox>
    </Panel>
</Window>