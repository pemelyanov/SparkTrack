<controls:ContentDialog xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:notification="clr-namespace:SparkTrack.AvaloniaImpl.Windows.Notification"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SparkTrack.AvaloniaImpl.Windows.Notification.NotificationWindow"
             x:DataType="notification:NotificationViewModel"
             PrimaryButtonText="{Binding AcceptText}"
             Title="{Binding Title}">
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
</controls:ContentDialog>
